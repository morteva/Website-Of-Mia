{
  "name": "website-of-mia",
  "compatibility_date": "2026-08-30",
  "build": {
    "command": "node scripts/build-site.mjs && node scripts/restore-tiny-mia-image.mjs && node scripts/build-deploy-assets.mjs"
  },
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "morteva.com",
      "custom_domain": true
    },
    {
      "pattern": "www.morteva.com",
      "custom_domain": true
    }
  ]
}

{
  "name": "website-of-mia",
  "compatibility_date": "2026-08-30",
  "build": {
    "command": "node scripts/validate-public.mjs && node scripts/build-deploy-assets.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "routes": [
    {
      "pattern": "morteva.com",
      "custom_domain": true
    },
    {
      "pattern": "www.morteva.com",
      "custom_domain": true
    }
  ],
  "main": "src/worker.ts",
  "d1_databases": [{"binding":"SHOP_ORDERS","database_name":"morteva-shop-orders","database_id":"1f37a318-f3b1-4f81-a07c-b50e563a6dcf","migrations_dir":"migrations/shop"}],
  "services": [
    {
      "binding": "NEWSLETTER",
      "service": "thisisbeside"
    }
  ]
}
